# AutoBot-OG environment configuration.
#
# Setup:
#   cp .env.template .env
#   chmod 600 .env                    (secrets — owner-only read)
#   then fill in real values below
#
# The .env file is gitignored. This template is committed as a
# self-documenting reference for what each variable does and which
# are required.

# =========================================================================
# IG broker credentials  (REQUIRED)
# =========================================================================
# Read by src/feed/ig_rest/auth.py and src/bot/main.py.

IG_USERNAME=your_ig_username
IG_PASSWORD=your_ig_password
IG_API_KEY=your_ig_api_key_from_ig_api_console

# Account environment. Code reads IG_ACC_TYPE (case-insensitive, uppercased).
# Set to DEMO for demo trading, LIVE for the production IG account.
# Note: the legacy template used IG_ENVIRONMENT — that name is NOT read
# by any code path. Use IG_ACC_TYPE.
IG_ACC_TYPE=DEMO

# =========================================================================
# Telegram alerts  (REQUIRED)
# =========================================================================
# Read by src/alerts/alerter.py.
# Bot token from @BotFather; chat ID is the ID of the chat (or group) the
# bot posts into — obtain via @userinfobot or the getUpdates API.

TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=your_chat_id

# =========================================================================
# Finnhub economic calendar  (REQUIRED — see note)
# =========================================================================
# Read by src/risk/news_calendar/finnhub_client.py. Without this key,
# FINNHUB_ENABLED is False and the calendar cache never refreshes. The
# news-blackout rule fails closed on stale cache (>5 min old by default),
# so the bot will reject 100% of entry candidates with reason
# "cache-stale". This key is functionally required for the bot to trade.
#
# Free tier from finnhub.io is sufficient for the economic-calendar
# endpoint at the 10s default poll cadence.

FINNHUB_API_KEY=your_finnhub_api_key

# =========================================================================
# Bot configuration  (REQUIRED)
# =========================================================================

# Comma-separated trading pairs. Read by src/bot/main.py:223. Must be
# a subset of the pairs supported by config/pair_config.py and by the
# news-blackout currency map (GBPUSD, EURUSD, USDJPY, USDCAD, GBPJPY).
BOT_PAIRS=GBPUSD,EURUSD,USDJPY,USDCAD

# Shadow mode: when true, the bot evaluates and logs trade candidates
# without sending orders to IG. Set false for actual demo trading.
# Default if unset: false.
BOT_SHADOW_MODE=false

# Log level for Python logging. INFO is the production default; DEBUG
# is useful when diagnosing strategy or risk-rule behaviour.
LOG_LEVEL=INFO

# =========================================================================
# Optional — structure engine logging (override defaults if needed)
# =========================================================================
# All have sensible defaults; uncomment to override.

# Persistent structure-state log (one JSONL line per bar transition).
# Default off; turn on to enable forensic replay of structure decisions.
# STRUCTURE_LOG_ENABLED=1
# STRUCTURE_LOG_PATH=data/structure/structure_state.jsonl

# Audit log for emitted structure alerts (one JSONL line per dispatch).
# STRUCTURE_ALERTS_LOG_PATH=data/alerts/structure_alerts.jsonl

# =========================================================================
# Optional — structure-alert dedupe cooldowns (seconds)
# =========================================================================
# Per-severity dedupe windows. Lowering these makes the bot louder
# (more Telegram messages for the same recurring level); raising them
# quietens it. Defaults are the Phase 12 locked values.

# INFO    — NEW_MAJOR_LEVEL, LEVEL_INVALIDATED, HOURLY_SUMMARY (2h)
# STRUCTURE_ALERTS_INFO_COOLDOWN_SEC=7200
# WARNING — HTF_BIAS_CHANGE, STRUCTURE_MODE_CHANGE, SWEEP/RECLAIM (1h)
# STRUCTURE_ALERTS_WARNING_COOLDOWN_SEC=3600
# CRITICAL — SUPPORT/RESISTANCE_ACCEPTANCE_BREAK (30m)
# STRUCTURE_ALERTS_CRITICAL_COOLDOWN_SEC=1800

# =========================================================================
# Optional — IG REST quirks
# =========================================================================

# Product type override for IG_REST orders. Default behaviour (unset)
# works for standard CFD accounts. Set only if instructed by IG support
# or after observing PRODUCT_TYPE rejections in journalctl.
# IG_PRODUCT_TYPE=

# =========================================================================
# Optional — news-calendar tuning
# =========================================================================

# Poll interval (seconds) for Finnhub. Default 10. Don't lower without
# checking Finnhub's rate limit on the calendar endpoint.
# NEWS_POLL_INTERVAL_SECS=10

# Staleness threshold (seconds) for the fail-closed blackout check.
# Default 300 (5 min). After this many seconds with no successful fetch,
# is_blackout() returns is_blocked=True with reason="cache-stale".
# NEWS_CACHE_STALENESS_THRESHOLD_SECS=300

# AutoBot-OG environment template. Copy to .env and fill in.
# Values are placeholders — real keys belong only in .env (gitignored).

# --- IG broker ---
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
IG_ACCOUNT_ID=
IG_ENVIRONMENT=demo  # demo | live

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Runtime ---
LOG_LEVEL=INFO
